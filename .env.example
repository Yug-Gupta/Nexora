# Copy this file to .env and adjust the values for your local services.
# Never commit a real .env file.

# --- Graph database (Neo4j) -------------------------------------------------
# Bolt URI of the running Neo4j instance.
NEO4J_URI=bolt://127.0.0.1:7687
# Neo4j user name.
NEO4J_USER=neo4j
# Neo4j password. Replace with the password you configured for Neo4j.
NEO4J_PASSWORD=change_me
# Optional database name; leave empty to use the server default (neo4j).
# NEO4J_DATABASE=neo4j

# --- Local model service (Ollama) -------------------------------------------
# HTTP endpoint of the running Ollama service.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model tag to use for both extraction and answering.
# Run `ollama list` to see what is installed; `ollama pull llama3.2` to fetch it.
OLLAMA_MODEL=llama3.2

# --- Retrieval behaviour -----------------------------------------------------
# How many relationship hops to walk when expanding a starting point (1-6).
NEXORA_RETRIEVAL_DEPTH=2
# Maximum number of evidence entries included in one answer prompt (4-60).
NEXORA_CONTEXT_LIMIT=18
# Maximum candidate starting entities returned by keyword search (1-30).
NEXORA_ENTRY_LIMIT=8

# --- Model request timeout ---------------------------------------------------
# Seconds to wait for a single Ollama request before giving up (5-3600).
NEXORA_LLM_TIMEOUT=300

# --- Logging -----------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR.
NEXORA_LOG_LEVEL=INFO
