# Copy this file to .env and adjust the values for your local services.
# Never commit a real .env file.

# --- Graph database (Neo4j) -------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
# NEO4J_DATABASE=neo4j

# --- Local model service (Ollama) -------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Retrieval behaviour -----------------------------------------------------
# How many relationship hops to walk when expanding a starting point.
VERIGRAPH_DEPTH=2
# Maximum number of evidence entries included in one prompt.
VERIGRAPH_CONTEXT_LIMIT=18
# Maximum candidate starting entities found by keyword search.
VERIGRAPH_ENTRY_LIMIT=8

# --- Logging -----------------------------------------------------------------
VERIGRAPH_LOG_LEVEL=INFO
