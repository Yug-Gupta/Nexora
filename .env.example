# Copy this file to .env and adjust the values for your environment.
# Never commit a real .env file, and never paste a real API key into code.

# --- Google Gemini (required for extraction + answering) ---------------------
# Create a free API key in Google AI Studio. This value is a secret: keep it
# out of git, out of logs and out of screenshots.
GEMINI_API_KEY=your_gemini_api_key_here
# Model used for both extraction and answering.
# Examples: gemini-3.6-flash, gemini-3.5-flash.
# Note: older tags such as gemini-2.5-flash are no longer served to new API
# keys and will fail with a 404 NOT_FOUND at generation time.
GEMINI_MODEL=gemini-3.6-flash

# --- Graph database (Neo4j local Docker or Neo4j AuraDB) --------------------
# Local Docker default:
NEO4J_URI=bolt://127.0.0.1:7687
# Neo4j AuraDB example (also set the AuraDB user/password):
# NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
# Neo4j password. Replace with the password you configured for Neo4j.
NEO4J_PASSWORD=change_me
# Optional database name; leave empty to use the server default (neo4j).
# NEO4J_DATABASE=neo4j

# --- Retrieval behaviour -----------------------------------------------------
# How many relationship hops to walk when expanding a starting point (1-6).
NEXORA_RETRIEVAL_DEPTH=2
# Maximum number of evidence entries included in one answer prompt (4-60).
NEXORA_CONTEXT_LIMIT=18
# Maximum candidate starting entities returned by keyword search (1-30).
NEXORA_ENTRY_LIMIT=8

# --- Model request timeout ---------------------------------------------------
# Seconds to wait for a single Gemini request before giving up (5-3600).
NEXORA_LLM_TIMEOUT=300

# --- Logging -----------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR.
NEXORA_LOG_LEVEL=INFO
